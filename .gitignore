# Node
node_modules/
dist/
coverage/
# Load test reports and the API log of each run (FMS-61); CI keeps them as artifacts.
load-report/
# The API contract coverage of the integration tests (FMS-100); CI keeps it as an artifact.
contract-coverage.json
# Uploaded documents in local development (FMS-17)
packages/backend/storage/
.env
.env.*
!.env.example
# The off-site backup repository's credentials (docker/postgres/offsite.env.example).
docker/postgres/offsite.env
# scripts/backup/pitr-restore.sh's passphrases while it runs (removed on exit).
.pitr-restore-env.*
# scripts/dr/rejoin.sh's settings while it runs (removed on exit).
.rejoin-env.*

# Python
__pycache__/
*.pyc
venv/
.venv/
# Generated by packages/ai-service/scripts/generate_training_data.py (seeded: rebuild it, never commit it).
packages/ai-service/data/
# Trained by packages/ai-service/scripts/train.py from that data (rebuild them, never commit them).
packages/ai-service/models/

# OS
.DS_Store
