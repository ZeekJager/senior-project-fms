# Shell scripts run inside Linux containers; CRLF line endings break them.
*.sh text eol=lf
# PostgreSQL reads these inside the containers too (FMS-94).
docker/postgres/*.conf text eol=lf
*.snap text eol=lf
docs/permissions.md text eol=lf
# Git hooks run under sh, so they must keep LF endings on Windows checkouts too.
.husky/** text eol=lf
