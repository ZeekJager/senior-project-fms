{
  "name": "fms-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc -b",
