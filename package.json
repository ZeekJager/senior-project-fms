{
  "name": "senior-project-fms",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet Management System (FMS) Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker-compose up --build --renew-anon-volumes",
    "dev:down": "docker-compose down",
    "dev:clean": "docker-compose down -v --remove-orphans",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "packages/backend/**/*.{ts,mts}": "eslint --max-warnings=0",
    "packages/eslint-plugin-fms/**/*.js": "eslint --max-warnings=0"
  }
}
