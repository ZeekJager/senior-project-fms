# The off-site backup repository (FMS-108, docs/backups.md#off-site-repository): copy to offsite.env (git-ignored)
# beside this file, fill it in, and recreate the database container (docker compose up -d postgres). pgBackRest
# reads these settings itself, so every WAL segment and base backup then goes to this repository as well.
#
# An S3 bucket in another region or with another provider, with:
#   - Object Lock on, in compliance mode, 30 days by default, so nothing written can be deleted or changed for
#     30 days, not even with these credentials;
#   - an access key that may read, list and write, never delete (the lock expires old files: retention below
#     only stops pgBackRest listing them);
#   - its own encryption passphrase, kept by the two people named in docs/backups.md.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/fms
PGBACKREST_REPO2_S3_BUCKET=fms-backups-offsite
PGBACKREST_REPO2_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PGBACKREST_REPO2_S3_REGION=eu-central-1
PGBACKREST_REPO2_S3_KEY=change-me
PGBACKREST_REPO2_S3_KEY_SECRET=change-me
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_CIPHER_PASS=change-me
# Two weekly fulls kept beyond the 30-day lock: point-in-time recovery from this copy reaches 14 days back too.
PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
PGBACKREST_REPO2_RETENTION_FULL=35
# Path-style URLs and no TLS check: only for a local S3 stand-in such as MinIO.
# PGBACKREST_REPO2_S3_URI_STYLE=path
# PGBACKREST_REPO2_STORAGE_VERIFY_TLS=n
