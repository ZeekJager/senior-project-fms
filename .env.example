# Environment for the Docker Compose stack (`make dev`).
#
# Create your own .env from this file with `make env` or
# `node scripts/init-env.mjs`, which replaces every `change-me` with a
# random value. .env is git-ignored: never commit real values, and use
# different secrets in every environment.

# --- PostgreSQL ---------------------------------------------------------
# Password of fms_admin, the schema owner. Migrations (`make migrate`)
# connect as this role; the running API does not.
DB_ADMIN_PASSWORD=change-me

# Password of fms_app, the role the API connects as (privileges narrowed
# by migration 013).
DB_APP_PASSWORD=change-me

# Both passwords are only applied when the database volume is first
# created. To change them later, run `make clean` (wipes the database)
# or change the roles' passwords inside PostgreSQL.

# Password of fms_replicator, the role the read replica streams from the
# primary with (FMS-94, docs/read-replica.md). Unlike the two above, the
# replica sets it on the primary every time it starts.
DB_REPLICATION_PASSWORD=change-me

# Reporting reads (fuel reconciliation, the audit log) go to the replica
# at DB_READ_HOST (Compose sets postgres-replica), as fms_app. Unset, they
# go to the primary. Further behind than this many seconds, or down, the
# API reads the primary instead and readiness reports the replica degraded.
# READ_REPLICA_MAX_LAG_SECONDS=30

# --- Backend API --------------------------------------------------------
# Signing key for access and refresh tokens (FMS-05). At least 32
# characters. Changing it signs every user out.
JWT_SECRET=change-me

# Backend log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Uploaded documents (FMS-17). The Compose stack keeps them on local disk
# in the document_files volume. Deployed environments set
# STORAGE_DRIVER=s3 and S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
# (plus S3_ENDPOINT and S3_REGION for MinIO or another S3-compatible
# store) in the backend's environment; see docs/api-contract.md section 8.

# Trip assignment (FMS-31): minutes a driver or vehicle needs between an
# en-route trip and the next one. When the trip under way (ending no
# earlier than now) plus this buffer runs past the next trip's start,
# assignment returns an overrun warning; it never blocks. Default 0.
# TRIP_OVERRUN_GRACE_MINUTES=0

# Real-time sockets (FMS-43, docs/realtime.md). Page origins other than the
# API's own host that may open a socket, comma-separated (the Vite dev server
# keeps the browser's Host, so it needs none).
# REALTIME_ALLOWED_ORIGINS=https://fleet.example.com
# The legacy client->server `location_update` socket event: off by default.
# REALTIME_LEGACY_LOCATION=false
# GPS ingestion (FMS-88, docs/gps-ingestion.md): VehicleLocationUpdated at
# most once per vehicle per this many seconds of its pings.
# TRACKING_EVENT_INTERVAL_SECONDS=5
# Alert engine (FMS-92, docs/alerts.md): a critical alert nobody acknowledges
# escalates to the next tier after this many minutes, then again after as many.
# ALERT_ESCALATION_MINUTES=15
# Fuel reconciliation (FMS-41, docs/fuel-reconciliation.md): a vehicle's month
# with fuel more than this many percent above or below what its trips needed
# is a fuel anomaly. The default of the fuel_variance_threshold_pct setting
# (FMS-80, docs/settings.md): an administrator's change on the Settings screen
# takes precedence.
# FUEL_VARIANCE_THRESHOLD_PCT=20

# --- Fuel anomaly rules on one fill-up (FMS-82, docs/fuel-anomaly-rules.md) ---
# A fill-up this many percent above what the distance since the vehicle's last
# fill-up could have used (and by at least 20 litres) is a refuel too soon.
# FUEL_REFUEL_EXCESS_PCT=50
# The band a litre may cost, in cents (ETB). Outside it, the fill-up is flagged.
# FUEL_PRICE_MIN_CENTS_PER_LITRE=3000
# FUEL_PRICE_MAX_CENTS_PER_LITRE=20000
# A fill-up logged with a position farther than this (km) from where the
# vehicle's GPS had it at that time is flagged.
# FUEL_LOCATION_MAX_KM=2

# --- External providers (FMS-85, docs/integrations.md) -----------------
# Each provider's secrets, by its code in integration.external_providers
# (upper case, _ for -). Never stored in the database or returned by the API.
# INTEGRATION_<CODE>_WEBHOOK_SECRET  HMAC key its webhooks are signed with (32+ characters)
# INTEGRATION_<CODE>_API_KEY         credential the adapter sends on outbound calls
# Docker Compose passes the backend's variables one by one: add a provider's
# to the backend service's environment in docker-compose.yml as well.
#
# Alerts by email, SMS and push (FMS-93, docs/notification-channels.md): a
# provider row per channel (provider_type notification, configuration.channel
# email, sms or push). docker-compose.yml passes these three codes' keys:
# INTEGRATION_SMTP_EMAIL_API_KEY=   the SMTP password
# INTEGRATION_SMS_GATEWAY_API_KEY=  the SMS gateway's key
# INTEGRATION_WEB_PUSH_API_KEY=     the VAPID private key (npm run push:keys -w packages/backend)
# The web app's public address, for the link in alert emails; unset, no link.
# APP_PUBLIC_URL=https://fms.example.com

# --- Redis (FMS-72) -----------------------------------------------------
# Cache, login throttle and job locks. Reachable only inside the Docker
# network (no published port). Not the system of record: the API keeps
# working from PostgreSQL when Redis is down.
REDIS_PASSWORD=change-me

# --- Predictive-maintenance service -------------------------------------
# Shared token the backend sends to the internal ML service (FMS-54/55), in
# the X-Internal-Token header. At least 32 characters: the service will not
# start with a shorter one.
ML_SERVICE_TOKEN=change-me
# The backend refuses a token shorter than 32 characters once ML_SERVICE_URL
# is set; make env generates a longer one.
# Where the backend reaches the service. docker-compose.yml sets it to
# http://ai-service:5000; unset, the backend scores nothing.
# ML_SERVICE_URL=http://localhost:5000
# The feature spec the core's extractor implements, shared with the service
# (FMS-127, docs/ml-model-registry.md). Relative to packages/backend.
# ML_FEATURE_SPEC_PATH=../ai-service/feature_spec.json

# --- Road routing (FMS-84, docs/routing.md) -----------------------------
# OSRM, set up once with `make routing`. docker-compose.yml points the backend
# at http://osrm:5000; set it empty to switch routing off (routes then keep
# the distance typed in). Outside Docker: http://127.0.0.1:5050.
# ROUTING_URL=http://127.0.0.1:5050
# Start OSRM with `make dev` too:
# COMPOSE_PROFILES=routing
# OSRM's port on the host (127.0.0.1 only).
# OSRM_HOST_PORT=5050

# --- Database backups (FMS-144, docs/backups.md) -------------------------
# pg_dump reads every table, which fms_app may not: it connects as
# BACKUP_DB_USER, else as DB_ADMIN_USER (the Docker stack's case). With
# neither, the Backups screen says backups are not set up.
# BACKUP_DB_USER=fms_backup
# BACKUP_DB_PASSWORD=change-me
# Where pg_dump and pg_restore are, when not on PATH (they must be 16 or newer).
# BACKUP_PG_BIN_DIR=C:/Program Files/PostgreSQL/16/bin
# Development only: run them in this PostgreSQL container instead.
# BACKUP_PG_CONTAINER=fms_postgres

# --- Frontend -----------------------------------------------------------
# VITE_* values are compiled into the public browser bundle. Never put a
# secret in a VITE_* variable.
VITE_API_URL=http://localhost:3000/api/v1
# Map tiles for the fleet map (FMS-44). Unset uses OpenStreetMap's own tiles,
# which are for light use only; production points these at its own tile server
# or a provider, with that provider's attribution (HTML).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# The driver's phone as the vehicle's GPS (FMS-57, docs/phone-gps.md): readings
# less precise than this many metres are dropped. 100 until the physical device
# test says otherwise.
# VITE_GPS_MAX_ACCURACY_M=100
