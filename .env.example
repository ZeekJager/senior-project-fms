# Environment for the Docker Compose stack (`make dev`).
#
# Create your own .env from this file with `make env` or
# `node scripts/init-env.mjs`, which replaces every `change-me` with a
# random value. .env is git-ignored: never commit real values, and use
# different secrets in every environment.

# --- PostgreSQL ---------------------------------------------------------
# Password of fms_admin, the schema owner. Migrations (`make migrate`)
# connect as this role; the running API does not.
DB_ADMIN_PASSWORD=change-me

# Password of fms_app, the role the API connects as (privileges narrowed
# by migration 013).
DB_APP_PASSWORD=change-me

# Both passwords are only applied when the database volume is first
# created. To change them later, run `make clean` (wipes the database)
# or change the roles' passwords inside PostgreSQL.

# --- Backend API --------------------------------------------------------
# Signing key for access and refresh tokens (FMS-05). At least 32
# characters. Changing it signs every user out.
JWT_SECRET=change-me

# Backend log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# --- Predictive-maintenance service -------------------------------------
# Shared token the backend sends to the internal ML service (FMS-54/55).
ML_SERVICE_TOKEN=change-me

# --- Frontend -----------------------------------------------------------
# VITE_* values are compiled into the public browser bundle. Never put a
# secret in a VITE_* variable.
VITE_API_URL=http://localhost:3000/api/v1
