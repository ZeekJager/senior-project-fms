# The production stack's settings (docker-compose.prod.yml, docs/deployment.md). Copy to prod.env, fill in,
# and keep prod.env off the repository (it is git-ignored). Make each change-me a fresh random value of 48 characters,
# for example from: openssl rand -base64 48 | tr -d "/+=" | head -c 48

# The site's host name; its DNS record points at this server, and ports 80 and 443 reach it.
FMS_DOMAIN=fleet.example.com
# An e-mail address for Let's Encrypt (expiry notices). "internal" uses Caddy's own authority: local runs only.
FMS_TLS_ISSUER=ops@example.com
# The images to run: the commit tag CI built them with (docs/production-images.md), and their registry, if any.
FMS_IMAGE_TAG=
FMS_REGISTRY=
# The compose files every command uses (docs/deployment.md, phase 6): with road routing, and the tunnel if any.
# Separated by ":" on Linux, ";" on Windows.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.routing.yml
# Only with docker-compose.tunnel.yml (docs/deployment.md#behind-a-cloudflare-tunnel): the Cloudflare Tunnel's token.
# CLOUDFLARE_TUNNEL_TOKEN=

DB_ADMIN_PASSWORD=change-me
DB_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me
# Encrypts licence and phone numbers. Losing it loses them: keep a copy off this server.
DATA_ENCRYPTION_KEY=change-me
ML_SERVICE_TOKEN=change-me

# The web app's Content-Security-Policy: report-only until its reports are clean, then enforce (docs/security.md).
CSP_MODE=report-only
